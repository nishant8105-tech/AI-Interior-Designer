{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai-bedroom-designer/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai-kitchen-designer/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai-living-room-designer/?$",
			"dest": "_render"
		},
		{
			"src": "^/ai-office-designer/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/analyze/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/google/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/me/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/signup/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/projects/create/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/projects/list/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/projects/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/report/generate/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/design/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/signup/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}