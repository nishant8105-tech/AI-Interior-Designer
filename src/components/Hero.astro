---
---

<section class="hero-band">
  <div class="hero-gradient"></div>
  <div class="hero-content">
    <span class="hero-badge">AI-Powered Design</span>
    <h1 class="hero-title">Your personal AI interior designer.</h1>
    <p class="hero-subtitle">
      Analyze, redesign, budget, furnish, and transform any room using AI.
      Get professional design feedback, budget estimates, and shopping plans.
    </p>
    <div class="hero-cta-row">
      <a href="/design" class="btn-primary">Design My Room</a>
      <a href="#examples" class="btn-secondary">See Examples</a>
    </div>
  </div>
</section>

<style>
  .hero-band {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-4xl) var(--spacing-lg);
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-canvas);
  }

  .hero-gradient {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 120%;
    height: 120%;
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, rgba(0, 124, 240, 0.15), transparent),
      radial-gradient(ellipse 60% 40% at 50% 30%, rgba(121, 40, 202, 0.12), transparent),
      radial-gradient(ellipse 70% 50% at 80% 45%, rgba(255, 0, 128, 0.1), transparent),
      radial-gradient(ellipse 50% 30% at 60% 60%, rgba(80, 227, 194, 0.1), transparent),
      radial-gradient(ellipse 40% 30% at 30% 60%, rgba(249, 203, 40, 0.08), transparent);
    filter: blur(60px);
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-family-geist-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    color: var(--color-body);
    background: var(--color-canvas-soft);
    padding: var(--spacing-xxs) var(--spacing-xs);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-lg);
  }

  .hero-title {
    font-family: var(--font-family-geist);
    font-size: 48px;
    font-weight: 600;
    line-height: 48px;
    letter-spacing: -2.4px;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-md);
  }

  .hero-subtitle {
    font-family: var(--font-family-geist);
    font-size: 18px;
    font-weight: 400;
    line-height: 28px;
    color: var(--color-body);
    margin: 0 0 var(--spacing-xl);
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-on-primary);
    background: var(--color-primary);
    font-family: var(--font-family-geist);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    padding: 0 var(--spacing-sm);
    height: 48px;
    border-radius: var(--radius-pill);
    transition: opacity 0.15s;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-canvas);
    font-family: var(--font-family-geist);
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    padding: 0 var(--spacing-sm);
    height: 48px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    transition: background 0.15s;
  }

  .btn-secondary:hover {
    background: var(--color-canvas-soft);
  }

  @media (max-width: 768px) {
    .hero-band {
      padding: var(--spacing-3xl) var(--spacing-md);
      min-height: 440px;
    }

    .hero-title {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -1.28px;
    }

    .hero-subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .hero-cta-row {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
