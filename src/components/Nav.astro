---
interface Props {
  showAuth?: boolean;
}

const { showAuth = true } = Astro.props;
---

<nav class="nav-bar">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="24" height="24" rx="6" fill="#171717"/>
        <path d="M7 8h10M7 12h6M7 16h8" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span>RoomIQ</span>
    </a>

    <div class="nav-links">
      <a href="#how-it-works" class="nav-link">How it works</a>
      <a href="#features" class="nav-link">Features</a>
      <a href="#examples" class="nav-link">Examples</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </div>

    <div class="nav-actions" id="nav-actions">
      {showAuth && (
        <>
          <a href="/login" class="nav-cta-login" id="nav-login">Log In</a>
          <a href="/signup" class="nav-cta-signup" id="nav-signup">Sign Up</a>
        </>
      )}
    </div>

    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="nav-mobile-menu" id="nav-mobile-menu">
    <a href="#how-it-works" class="nav-mobile-link">How it works</a>
    <a href="#features" class="nav-mobile-link">Features</a>
    <a href="#examples" class="nav-mobile-link">Examples</a>
    <a href="#faq" class="nav-mobile-link">FAQ</a>
    <div class="nav-mobile-actions" id="nav-mobile-actions">
      <a href="/login" class="nav-cta-login">Log In</a>
      <a href="/signup" class="nav-cta-signup">Sign Up</a>
    </div>
  </div>
</nav>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    height: 64px;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-family-geist);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.32px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-body);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: -0.28px;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    transition: color 0.15s, background-color 0.15s;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .nav-cta-login {
    text-decoration: none;
    color: var(--color-ink);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    padding: 0 var(--spacing-xs);
    height: 28px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    transition: background 0.15s;
  }

  .nav-cta-login:hover {
    background: var(--color-canvas-soft-2);
  }

  .nav-cta-signup {
    text-decoration: none;
    color: var(--color-on-primary);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    padding: 0 var(--spacing-xs);
    height: 28px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-primary);
    transition: opacity 0.15s;
  }

  .nav-cta-signup:hover {
    opacity: 0.9;
  }

  .nav-cta-dashboard {
    text-decoration: none;
    color: var(--color-body);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    padding: 0 var(--spacing-xs);
    height: 28px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    transition: background 0.15s;
  }

  .nav-cta-dashboard:hover {
    background: var(--color-canvas-soft-2);
  }

  .nav-cta-logout {
    text-decoration: none;
    color: var(--color-body);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    padding: 0 var(--spacing-xs);
    height: 28px;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-canvas);
    cursor: pointer;
    border: none;
    transition: background 0.15s;
  }

  .nav-cta-logout:hover {
    background: var(--color-canvas-soft-2);
  }

  .nav-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-ink);
    padding: var(--spacing-xs);
  }

  .nav-mobile-menu {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-actions {
      display: none;
    }

    .nav-hamburger {
      display: flex;
    }

    .nav-mobile-menu {
      display: flex;
      flex-direction: column;
      padding: var(--spacing-md) var(--spacing-lg);
      border-top: 1px solid var(--color-hairline);
      background: var(--color-canvas);
    }

    .nav-mobile-link {
      text-decoration: none;
      color: var(--color-body);
      font-family: var(--font-family-geist);
      font-size: 16px;
      padding: var(--spacing-sm) 0;
      border-bottom: 1px solid var(--color-hairline);
    }

    .nav-mobile-actions {
      display: flex;
      gap: var(--spacing-xs);
      padding-top: var(--spacing-md);
    }
  }
</style>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('nav-mobile-menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.style.display === 'flex';
    if (mobileMenu) {
      mobileMenu.style.display = isOpen ? 'none' : 'flex';
    }
  });

  // Check auth state and update nav
  async function checkAuth() {
    try {
      const res = await fetch('/api/auth/me');
      const data = await res.json();

      const navActions = document.getElementById('nav-actions');
      const mobileActions = document.getElementById('nav-mobile-actions');

      if (data.authenticated && navActions) {
        navActions.innerHTML = `
          <a href="/dashboard" class="nav-cta-dashboard">Dashboard</a>
          <a href="/design" class="nav-cta-signup">Design</a>
          <a href="/api/auth/logout" class="nav-cta-logout">Logout</a>
        `;
      }

      if (data.authenticated && mobileActions) {
        mobileActions.innerHTML = `
          <a href="/dashboard" class="nav-cta-login">Dashboard</a>
          <a href="/design" class="nav-cta-signup">Design</a>
          <a href="/api/auth/logout" class="nav-cta-logout">Logout</a>
        `;
      }
    } catch {
      // Not authenticated, keep default state
    }
  }

  checkAuth();
</script>
