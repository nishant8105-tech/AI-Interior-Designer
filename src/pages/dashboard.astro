---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Dashboard — RoomIQ">
  <Nav showAuth={false} />
  <main class="dashboard-page">
    <div class="dashboard-container">
      <div class="dashboard-header">
        <div>
          <h1 class="dashboard-title">Your Projects</h1>
          <p class="dashboard-subtitle">View and manage your room analyses</p>
        </div>
        <a href="/design" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          New Project
        </a>
      </div>

      <div class="projects-grid" id="projects-grid">
        <div class="loading-state" id="loading-state">
          <div class="loader"></div>
          <p>Loading projects...</p>
        </div>

        <div class="empty-state" id="empty-state" style="display: none;">
          <div class="empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>No projects yet</h3>
          <p>Upload your first room photo to get started</p>
          <a href="/design" class="btn-primary">Start Designing</a>
        </div>

        <div class="projects-list" id="projects-list" style="display: none;"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .dashboard-page {
    min-height: calc(100vh - 64px);
    background: var(--color-canvas-soft);
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-xl);
  }

  .dashboard-title {
    font-family: var(--font-family-geist);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -1.28px;
    color: var(--color-ink);
    margin: 0;
  }

  .dashboard-subtitle {
    font-family: var(--font-family-geist);
    font-size: 16px;
    color: var(--color-body);
    margin: var(--spacing-xxs) 0 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    height: 40px;
    padding: 0 var(--spacing-md);
    font-family: var(--font-family-geist);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius-pill);
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .loading-state,
  .empty-state {
    text-align: center;
    padding: var(--spacing-5xl) var(--spacing-xl);
    background: var(--color-canvas);
    border-radius: var(--radius-lg);
    box-shadow:
      0px 1px 1px rgba(0, 0, 0, 0.02),
      inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .loader {
    width: 48px;
    height: 48px;
    border: 3px solid var(--color-hairline);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto var(--spacing-md);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .empty-icon {
    color: var(--color-mute);
    margin-bottom: var(--spacing-md);
  }

  .empty-state h3 {
    font-family: var(--font-family-geist);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-xs);
  }

  .empty-state p {
    font-family: var(--font-family-geist);
    font-size: 16px;
    color: var(--color-body);
    margin: 0 0 var(--spacing-lg);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--spacing-lg);
  }

  @media (max-width: 600px) {
    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-md);
    }

    .projects-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  async function loadProjects() {
    const loading = document.getElementById('loading-state')!;
    const empty = document.getElementById('empty-state')!;
    const list = document.getElementById('projects-list')!;

    try {
      const res = await fetch('/api/projects/list');
      const data = await res.json();

      loading.style.display = 'none';

      if (!data.projects || data.projects.length === 0) {
        empty.style.display = 'block';
        return;
      }

      list.style.display = 'grid';
      list.innerHTML = data.projects.map((p: any) => `
        <div class="project-card">
          <div class="project-header">
            <span class="project-room">${p.room_type.replace('_', ' ')}</span>
            <span class="project-date">${new Date(p.created_at).toLocaleDateString()}</span>
          </div>
          <h3 class="project-title">${p.title}</h3>
          ${p.room_analyses?.[0] ? `
            <div class="project-score">
              <span class="score-label">Score</span>
              <span class="score-value">${p.room_analyses[0].design_score}/100</span>
            </div>
          ` : ''}
          <div class="project-actions">
            <a href="/design?project=${p.id}" class="btn-view">View</a>
            <button class="btn-delete" data-id="${p.id}">Delete</button>
          </div>
        </div>
      `).join('');

      // Add delete handlers
      list.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.target as HTMLElement).getAttribute('data-id');
          if (confirm('Delete this project?')) {
            await fetch(`/api/projects/${id}`, { method: 'DELETE' });
            loadProjects();
          }
        });
      });
    } catch {
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  loadProjects();
</script>
